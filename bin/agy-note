    <script>
        const rawNotes = {notes_json_str};
        let activeCategory = 'all';
        let splitModeActive = false;
        let selectedNoteIds = new Set();

        function initTheme() {{
            const saved = localStorage.getItem('agy_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', saved);
            updateThemeBtn(saved);
        }}

        function toggleTheme() {{
            const current = document.documentElement.getAttribute('data-theme') || 'dark';
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('agy_theme', next);
            updateThemeBtn(next);
        }}

        function updateThemeBtn(theme) {{
            const icon = document.getElementById('themeIcon');
            const label = document.getElementById('themeLabel');
            if (icon && label) {{
                if (theme === 'dark') {{
                    icon.innerText = '☀️';
                    label.innerText = 'Sáng';
                }} else {{
                    icon.innerText = '🌙';
                    label.innerText = 'Tối';
                }}
            }}
        }}

        document.addEventListener('keydown', (e) => {{
            if (e.key === '/' && document.activeElement !== document.getElementById('searchInput')) {{
                e.preventDefault();
                document.getElementById('searchInput').focus();
            }}
            if (e.key === 'Escape') {{
                closeSplitModal();
            }}
        }});

        function renderCategories() {{
            const catCounts = {{}};
            rawNotes.forEach(n => {{
                const c = (n.category || 'General').toLowerCase();
                catCounts[c] = (catCounts[c] || 0) + 1;
            }});

            const container = document.getElementById('categoryChips');
            container.innerHTML = `<span class="chip active" data-cat="all">Tất cả <span class="chip-count">${{rawNotes.length}}</span></span>`;
            
            Object.keys(catCounts).sort().forEach(c => {{
                const span = document.createElement('span');
                span.className = 'chip';
                span.dataset.cat = c;
                span.innerHTML = `${{c}} <span class="chip-count">${{catCounts[c]}}</span>`;
                span.onclick = () => filterCategory(c);
                container.appendChild(span);
            }});
            container.children[0].onclick = () => filterCategory('all');
        }}

        function filterCategory(cat) {{
            activeCategory = cat.toLowerCase();
            document.querySelectorAll('#categoryChips .chip').forEach(c => {{
                c.classList.toggle('active', c.dataset.cat.toLowerCase() === activeCategory);
            }});
            filterAndRenderNotes();
        }}

        function toggleSplitMode() {{
            splitModeActive = !splitModeActive;
            document.body.classList.toggle('split-mode-active', splitModeActive);
            const btn = document.getElementById('toggleSplitBtn');
            btn.classList.toggle('active', splitModeActive);
            if (!splitModeActive) {{
                clearSelection();
            }}
            filterAndRenderNotes();
        }}

        function toggleSelectNote(id, event) {{
            if (event) event.stopPropagation();
            if (selectedNoteIds.has(id)) {{
                selectedNoteIds.delete(id);
            }} else {{
                if (selectedNoteIds.size >= 4) {{
                    alert('Tối đa 4 note!');
                    return;
                }}
                selectedNoteIds.add(id);
            }}
            updateFloatingBar();
            filterAndRenderNotes();
        }}

        function updateFloatingBar() {{
            const count = selectedNoteIds.size;
            const bar = document.getElementById('floatingBar');
            document.getElementById('selectedCountText').innerText = `${{count}} note đã chọn`;
            if (count >= 2) {{
                bar.classList.add('visible');
            }} else {{
                bar.classList.remove('visible');
            }}
        }}

        function clearSelection() {{
            selectedNoteIds.clear();
            updateFloatingBar();
            filterAndRenderNotes();
        }}

        function launchSplitView(customIds) {{
            const ids = customIds || Array.from(selectedNoteIds);
            if (ids.length < 2) {{
                alert('Vui lòng chọn ít nhất 2 note!');
                return;
            }}

            const container = document.getElementById('splitGridContainer');
            container.innerHTML = '';
            
            container.className = 'split-grid-container';
            if (ids.length === 2) container.classList.add('cols-2');
            else if (ids.length === 3) container.classList.add('cols-3');
            else if (ids.length >= 4) container.classList.add('cols-4');

            ids.forEach(id => {{
                const note = rawNotes.find(n => n.id === id || n.id.startsWith(id));
                if (!note) return;

                const pane = document.createElement('div');
                pane.className = 'split-pane';
                pane.innerHTML = `
                    <div class="split-pane-header">
                        <span>[${{note.category || 'Note'}}] ${{note.title}}</span>
                        <a href="${{note.html_file}}" target="_blank">Tab riêng ↗</a>
                    </div>
                    <iframe src="${{note.html_file}}"></iframe>
                `;
                container.appendChild(pane);
            }});

            document.getElementById('splitModal').classList.add('active');
        }}

        function closeSplitModal() {{
            document.getElementById('splitModal').classList.remove('active');
        }}

        function filterAndRenderNotes() {{
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            const grid = document.getElementById('notesGrid');
            grid.innerHTML = '';

            const filtered = rawNotes.filter(n => {{
                const nCat = (n.category || 'General').toLowerCase();
                const matchCat = activeCategory === 'all' || nCat === activeCategory;
                
                const matchQuery = !query ||
                    (n.title && n.title.toLowerCase().includes(query)) ||
                    (n.category && n.category.toLowerCase().includes(query)) ||
                    (n.snippet_preview && n.snippet_preview.toLowerCase().includes(query)) ||
                    (n.start_marker && n.start_marker.toLowerCase().includes(query)) ||
                    (n.end_marker && n.end_marker.toLowerCase().includes(query)) ||
                    (n.tags && n.tags.some(t => t.toLowerCase().includes(query)));
                
                return matchCat && matchQuery;
            }});

            document.getElementById('statsBadge').innerHTML = `${{filtered.length}} / ${{rawNotes.length}} Notes`;

            if (filtered.length === 0) {{
                grid.innerHTML = `
                    <div class="empty-state">
                        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <p style="margin-top:10px">Không tìm thấy ghi chú nào.</p>
                    </div>
                `;
                return;
            }}

            filtered.forEach(note => {{
                let dateStr = note.created_at;
                try {{
                    const d = new Date(note.created_at);
                    dateStr = d.toLocaleTimeString('vi-VN', {{hour: '2-digit', minute:'2-digit'}}) + ' ' + d.toLocaleDateString('vi-VN');
                }} catch(e) {{}}

                const tagsHtml = (note.tags || []).map(t => `<span class="tag-pill">#${{t}}</span>`).join('');
                
                let landmarkLine = '';
                if (note.start_marker || note.end_marker) {{
                    const s = note.start_marker ? `🟢 ${{note.start_marker.slice(0, 22)}}...` : '';
                    const e = note.end_marker ? ` 🔴 ${{note.end_marker.slice(0, 22)}}` : '';
                    landmarkLine = `<div class="card-landmarks">${{s}}${{e}}</div>`;
                }}

                const isSelected = selectedNoteIds.has(note.id);
                const card = document.createElement('div');
                card.className = `note-card ${{isSelected ? 'selected' : ''}}`;
                card.onclick = (e) => {{
                    if (splitModeActive) {{
                        toggleSelectNote(note.id, e);
                    }} else {{
                        window.location.href = note.html_file;
                    }}
                }};

                card.innerHTML = `
                    <input type="checkbox" class="card-checkbox" ${{isSelected ? 'checked' : ''}} onclick="toggleSelectNote('${{note.id}}', event)">
                    <div class="card-top">
                        <div class="card-meta">
                            <span class="card-cat">${{note.category || 'General'}}</span>
                            <span class="card-date">${{dateStr}}</span>
                        </div>
                        <div class="card-title">${{note.title}}</div>
                        ${{landmarkLine}}
                        <div class="card-snippet">${{note.snippet_preview || ''}}</div>
                    </div>
                    <div class="card-tags">
                        ${{tagsHtml || '<span class="tag-pill" style="opacity:0.4">#note</span>'}}
                    </div>
                `;
                grid.appendChild(card);
            }});
        }}

        function checkUrlParams() {{
            const params = new URLSearchParams(window.location.search);
            const compareStr = params.get('compare');
            if (compareStr) {{
                const ids = compareStr.split(',').filter(x => x.trim());
                if (ids.length >= 2) {{
                    setTimeout(() => {{
                        launchSplitView(ids);
                    }}, 300);
                }}
            }}
        }}

        document.getElementById('searchInput').addEventListener('input', filterAndRenderNotes);

        initTheme();
        renderCategories();
        filterAndRenderNotes();
        checkUrlParams();
    </script>
</body>
</html>
"""
    try:
        with open(HUB_FILE, "w", encoding="utf-8") as f:
            f.write(hub_html)
    except Exception as e:
        print(f"{RED}Lỗi khi tạo Hub HTML: {e}{RESET}", file=sys.stderr)

def deploy_to_cloud(silent=False):
    """
    Deploys notes directory to the configured cloud provider in the background.
    """
    cfg = load_deploy_config()
    provider = cfg.get("provider")
    if not provider:
        return False, "Chưa thiết lập Cloud Provider."

    try:
        if provider == "cloudflare":
            project = cfg.get("project_name", "agy-notes")
            cmd = ["npx", "-y", "wrangler", "pages", "deploy", NOTES_DIR, "--project-name", project, "--commit-dirty=true"]
            res = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
            if res.returncode == 0:
                if not silent:
                    print(f"{GREEN}✓ Đã tự động đồng bộ lên Cloudflare Pages!{RESET}")
                return True, "Cloudflare Pages synced"
            else:
                return False, res.stderr

        elif provider == "vercel":
            cmd = ["npx", "-y", "vercel", "deploy", NOTES_DIR, "--prod", "--yes"]
            res = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
            if res.returncode == 0:
                if not silent:
                    print(f"{GREEN}✓ Đã tự động đồng bộ lên Vercel!{RESET}")
                return True, "Vercel synced"
            else:
                return False, res.stderr

        elif provider == "github":
            subprocess.run(["git", "-C", NOTES_DIR, "add", "."], check=True)
            subprocess.run(["git", "-C", NOTES_DIR, "commit", "-m", "Auto sync notes [skip ci]"], check=True)
            subprocess.run(["git", "-C", NOTES_DIR, "push", "origin", "main"], check=True)
            if not silent:
                print(f"{GREEN}✓ Đã tự động push lên GitHub Pages!{RESET}")
            return True, "GitHub Pages synced"

    except Exception as e:
        return False, str(e)

    return False, "Unknown provider"

def async_auto_deploy():
    """
    Spawns a background thread to deploy without delaying any note saving operation.
    """
    cfg = load_deploy_config()
    if cfg.get("auto_sync", True) and cfg.get("provider"):
        t = threading.Thread(target=deploy_to_cloud, kwargs={"silent": True}, daemon=True)
        t.start()

def add_note(title, content, category="General", tags=None, start_marker=None, end_marker=None, conversation_id=None):
    """
    Core function to save a snippet note with landmarks, compile HTML, and update the hub.
    Triggers automatic cloud background deploy!
    """
    ensure_dirs()
    if tags is None:
        tags = []
    elif isinstance(tags, str):
        tags = [t.strip() for t in tags.split(",") if t.strip()]

    title = title.strip() or "Untitled Snippet"
    category = category.strip() or "General"
    
    clean_lines = [l.strip() for l in content.split("\n") if l.strip() and not l.startswith("#") and not l.startswith("```")]
    
    if not start_marker and clean_lines:
        start_marker = clean_lines[0][:60]
    if not end_marker and clean_lines:
        end_marker = clean_lines[-1][:60]

    slug = re.sub(r'[^a-zA-Z0-9_-]', '', title.lower().replace(' ', '-'))[:30]
    ts_str = datetime.now().strftime("%Y%m%d-%H%M%S")
    note_id = f"{ts_str}-{slug}" if slug else ts_str
    
    html_filename = f"{note_id}.html"
    html_filepath = os.path.join(HTML_DIR, html_filename)
    relative_html = f"html/{html_filename}"

    md_filepath = os.path.join(MD_DIR, f"{note_id}.md")
    with open(md_filepath, "w", encoding="utf-8") as f:
        f.write(content)

    snippet_preview = " ".join(clean_lines)[:180] if clean_lines else content[:180]

    note_data = {
        "id": note_id,
        "title": title,
        "category": category,
        "tags": tags,
        "created_at": datetime.now().isoformat(),
        "start_marker": start_marker or "",
        "end_marker": end_marker or "",
        "snippet_preview": snippet_preview,
        "html_file": relative_html,
        "content": content,
        "conversation_id": conversation_id or ""
    }

    rendered_html = generate_single_note_html(note_data)
    with open(html_filepath, "w", encoding="utf-8") as f:
        f.write(rendered_html)

    meta_list = load_metadata()
    meta_list.insert(0, {
        "id": note_id,
        "title": title,
        "category": category,
        "tags": tags,
        "created_at": note_data["created_at"],
        "start_marker": note_data["start_marker"],
        "end_marker": note_data["end_marker"],
        "snippet_preview": snippet_preview,
        "html_file": relative_html,
        "content": content,
        "conversation_id": note_data["conversation_id"]
    })
    save_metadata(meta_list)
    generate_web_hub(meta_list)

    # Trigger background auto deploy
    async_auto_deploy()

    return note_data, html_filepath

def delete_note_by_id(note_id):
    meta_list = load_metadata()
    target = None
    new_list = []
    for item in meta_list:
        if item["id"] == note_id or item["id"].startswith(note_id):
            target = item
        else:
            new_list.append(item)
    
    if target:
        html_file = os.path.join(NOTES_DIR, target["html_file"])
        if os.path.exists(html_file):
            try:
                os.remove(html_file)
            except Exception:
                pass
        md_file = os.path.join(MD_DIR, f"{target['id']}.md")
        if os.path.exists(md_file):
            try:
                os.remove(md_file)
            except Exception:
                pass
        save_metadata(new_list)
        generate_web_hub(new_list)
        async_auto_deploy()
        return True, target["title"]
    return False, None

def open_in_browser(file_path):
    abs_path = os.path.abspath(file_path)
    if not os.path.exists(abs_path):
        print(f"{RED}Không tìm thấy file: {abs_path}{RESET}")
        return
    
    try:
        if sys.platform == "darwin":
            subprocess.run(["open", abs_path])
        elif sys.platform.startswith("linux"):
            subprocess.run(["xdg-open", abs_path], stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
        else:
            os.startfile(abs_path)
        print(f"{GREEN}✓ Đã mở trên trình duyệt: {abs_path}{RESET}")
    except Exception as e:
        print(f"{RED}Không thể mở trình duyệt tự động: {e}{RESET}")
        print(f"Vui lòng mở file bằng tay: {CYAN}file://{abs_path}{RESET}")

def open_multiple_in_browser(targets):
    meta_list = load_metadata()
    resolved_ids = []
    resolved_files = []

    for t in targets:
        target_item = None
        if str(t).isdigit():
            idx = int(t) - 1
            if 0 <= idx < len(meta_list):
                target_item = meta_list[idx]
        else:
            for n in meta_list:
                if n["id"].startswith(t):
                    target_item = n
                    break
        if target_item:
            resolved_ids.append(target_item["id"])
            resolved_files.append(os.path.join(NOTES_DIR, target_item["html_file"]))

    if not resolved_ids:
        print(f"{RED}Không tìm thấy các note được chỉ định: {targets}{RESET}")
        return

    if len(resolved_ids) >= 2:
        compare_url = f"file://{HUB_FILE}?compare={','.join(resolved_ids)}"
        print(f"\n{BOLD}{MAGENTA}⚡ Đang mở chế độ SO SÁNH / SPLIT VIEW {len(resolved_ids)} Notes cùng lúc...{RESET}")
        try:
            if sys.platform == "darwin":
                subprocess.run(["open", compare_url])
            elif sys.platform.startswith("linux"):
                subprocess.run(["xdg-open", compare_url], stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
            else:
                os.startfile(compare_url)
            print(f"{GREEN}✓ Đã mở giao diện Split-Screen trên trình duyệt!{RESET}")
        except Exception:
            for f in resolved_files:
                open_in_browser(f)
    else:
        for f in resolved_files:
            open_in_browser(f)

def view_note_terminal(note_id):
    meta_list = load_metadata()
    target = None
    if str(note_id).isdigit():
        idx = int(note_id) - 1
        if 0 <= idx < len(meta_list):
            target = meta_list[idx]
    if not target:
        for n in meta_list:
            if n["id"] == note_id or n["id"].startswith(note_id):
                target = n
                break
    if not target:
        print(f"{RED}Không tìm thấy note tương ứng: {note_id}{RESET}")
        return

    html_file = os.path.join(NOTES_DIR, target["html_file"])
    print(f"\n{BOLD}{BLUE}========================================================================{RESET}")
    print(f"{BOLD}Tiêu đề: {CYAN}{target['title']}{RESET}")
    print(f"{BOLD}Category: {MAGENTA}{target.get('category', 'General')}{RESET} | Tags: {YELLOW}{', '.join(target.get('tags', []))}{RESET}")
    print(f"{BOLD}Thời gian: {DIM}{target.get('created_at', '')}{RESET}")
    if target.get("start_marker"):
        print(f"{GREEN}🟢 Mốc đầu:{RESET} \"{target['start_marker']}\"")
    if target.get("end_marker"):
        print(f"{YELLOW}🔴 Mốc cuối:{RESET} \"{target['end_marker']}\"")
    print(f"{BOLD}{BLUE}========================================================================{RESET}\n")
    print(f"{target.get('content') or target.get('snippet_preview', '')}\n")
    print(f"{DIM}File HTML đầy đủ: file://{html_file}{RESET}\n")

def list_notes_terminal():
    meta_list = load_metadata()
    if not meta_list:
        print(f"{YELLOW}Chưa có ghi chú nào trong kho lưu trữ.{RESET}")
        return []
    
    cfg = load_deploy_config()
    live_url = cfg.get("live_url")

    print(f"\n{BOLD}{MAGENTA}📝 DANH SÁCH GHI CHÚ ĐÃ LƯU (AGY NOTES):{RESET}")
    if live_url:
        print(f"🌐 {GREEN}Live Cloud URL: {BOLD}{live_url}{RESET}")
    print(f"{DIM}" + "─" * 88 + f"{RESET}")
    print(f"{BOLD}{'STT':<4} {'Thời gian':<13} {'Category':<13} {'Tiêu đề & Mốc trích xuất'}{RESET}")
    print(f"{DIM}" + "─" * 88 + f"{RESET}")

    for idx, n in enumerate(meta_list, 1):
        try:
            dt = datetime.fromisoformat(n["created_at"]).strftime("%d/%m %H:%M")
        except Exception:
            dt = n.get("created_at", "")[:10]
        cat_disp = format_category_terminal(n.get("category", ""))
        title = n.get("title", "Untitled")
        
        landmark_disp = ""
        if n.get("start_marker"):
            short_marker = n["start_marker"][:22] + "..." if len(n["start_marker"]) > 22 else n["start_marker"]
            landmark_disp = f" {DIM}(Mốc: {short_marker}){RESET}"
            
        print(f"{CYAN}{idx:<4}{RESET} {DIM}{dt:<13}{RESET} {cat_disp:<22} {BOLD}{title}{RESET}{landmark_disp}")

    print(f"{DIM}" + "─" * 88 + f"{RESET}")
    return meta_list

def interactive_setup_cloud():
    print(f"\n{BOLD}{CYAN}☁️ THIẾT LẬP TỰ ĐỘNG ĐỒNG BỘ CLOUD PUBLIC (MỞ XEM MỌI NƠI){RESET}")
    print(f"Chọn nền tảng lưu trữ bạn muốn sử dụng:\n")
    print(f"  1. {BOLD}Cloudflare Pages{RESET} (Khuyên dùng — Cực nhanh, link https://<project>.pages.dev)")
    print(f"  2. {BOLD}Vercel{RESET} (Link https://<project>.vercel.app)")
    print(f"  3. {BOLD}GitHub Pages{RESET} (Repo GitHub + GitHub Pages)")
    print(f"  4. {BOLD}Nhập thủ công Link Live đã có sẵn{RESET}")
    print(f"  q. Thoát\n")

    choice = input(f"{BOLD}Lựa chọn [1/2/3/4]: {RESET}").strip()
    if choice == "1":
        project = input(f"{CYAN}Tên Project Cloudflare Pages (mặc định: agy-notes): {RESET}").strip() or "agy-notes"
        live_url = f"https://{project}.pages.dev"
        save_deploy_config({
            "provider": "cloudflare",
            "project_name": project,
            "live_url": live_url,
            "auto_sync": True
        })
        print(f"\n{GREEN}✓ Đã lưu cấu hình Cloudflare Pages!{RESET}")
        print(f"👉 Link của bạn: {BOLD}{live_url}{RESET}")
        generate_web_hub(load_metadata())

    elif choice == "2":
        project = input(f"{CYAN}Tên Project Vercel (mặc định: agy-notes): {RESET}").strip() or "agy-notes"
        live_url = f"https://{project}.vercel.app"
        save_deploy_config({
            "provider": "vercel",
            "project_name": project,
            "live_url": live_url,
            "auto_sync": True
        })
        print(f"\n{GREEN}✓ Đã lưu cấu hình Vercel!{RESET}")
        print(f"👉 Link của bạn: {BOLD}{live_url}{RESET}")
        generate_web_hub(load_metadata())

    elif choice == "3":
        repo_url = input(f"{CYAN}Git Remote Repo URL (VD: git@github.com:username/my-notes.git): {RESET}").strip()
        live_url = input(f"{CYAN}GitHub Pages URL (VD: https://username.github.io/my-notes/): {RESET}").strip()
        save_deploy_config({
            "provider": "github",
            "repo_url": repo_url,
            "live_url": live_url,
            "auto_sync": True
        })
        print(f"\n{GREEN}✓ Đã lưu cấu hình GitHub Pages!{RESET}")
        generate_web_hub(load_metadata())

    elif choice == "4":
        live_url = input(f"{CYAN}Nhập URL Live Web của bạn: {RESET}").strip()
        save_deploy_config({
            "provider": "custom",
            "live_url": live_url,
            "auto_sync": False
        })
        print(f"\n{GREEN}✓ Đã lưu Link Live!{RESET}")
        generate_web_hub(load_metadata())

def interactive_menu():
    while True:
        meta_list = list_notes_terminal()
        if not meta_list:
            print(f"\n{YELLOW}💡 Để tạo ghi chú mới, chạy: {BOLD}agy-note add{RESET}\n")
            break

        print(f"{BOLD}Thao tác:{RESET}")
        print(f"  • Nhập {CYAN}<STT>{RESET}                   : Mở Note đơn trên Web Browser (VD: {CYAN}1{RESET})")
        print(f"  • Nhập {MAGENTA}c <STT1> <STT2> ...{RESET}       : Xem {MAGENTA}CÙNG LÚC 2-4 Notes{RESET} ở chế độ Split Screen (VD: {MAGENTA}c 1 2{RESET})")
        print(f"  • Nhập {MAGENTA}w{RESET} hoặc {MAGENTA}0{RESET}               : Mở Trang Web Hub Dashboard (index.html)")
        print(f"  • Nhập {GREEN}v <STT>{RESET}                 : Xem nội dung & mốc trích xuất trên Terminal")
        print(f"  • Nhập {YELLOW}s <từ_khóa>{RESET}            : Tìm kiếm note theo mốc/từ khóa")
        print(f"  • Nhập {BLUE}cloud{RESET}                   : Thiết lập kết nối Cloud Public")
        print(f"  • Nhập {RED}d <STT>{RESET}                 : Xóa note")
        print(f"  • Nhập {CYAN}q{RESET}                       : Thoát\n")

        raw_choice = input(f"{BOLD}Chọn thao tác: {RESET}").strip()
        if not raw_choice or raw_choice.lower() in ["q", "exit", "quit"]:
            break

        if raw_choice in ["0", "w", "web", "hub"]:
            open_in_browser(HUB_FILE)
            continue

        if raw_choice.lower() in ["cloud", "deploy", "sync"]:
            interactive_setup_cloud()
            continue

        parts = raw_choice.split()
        
        if (parts[0].lower() in ["c", "compare", "split"] and len(parts) >= 3) or (len(parts) >= 2 and all(p.isdigit() for p in parts)):
            target_indices = [p for p in parts if p.isdigit()]
            if len(target_indices) >= 2:
                open_multiple_in_browser(target_indices[:4])
                continue

        if parts[0].lower() == "v" and len(parts) >= 2:
            view_note_terminal(parts[1])
            continue

        if parts[0].lower() == "d" and len(parts) >= 2:
            target_id = parts[1]
            if parts[1].isdigit():
                idx = int(parts[1]) - 1
                if 0 <= idx < len(meta_list):
                    target_id = meta_list[idx]["id"]
            ok, title = delete_note_by_id(target_id)
            if ok:
                print(f"{GREEN}✓ Đã xóa ghi chú '{title}' thành công!{RESET}")
            else:
                print(f"{RED}Không tìm thấy note để xóa.{RESET}")
            continue

        if parts[0].lower() == "s" and len(parts) >= 2:
            query = " ".join(parts[1:]).lower()
            print(f"\n{BOLD}Kết quả tìm kiếm cho: \"{query}\"{RESET}")
            found = False
            for idx, n in enumerate(meta_list, 1):
                if (query in n["title"].lower() or 
                    query in n.get("category", "").lower() or
                    query in n.get("start_marker", "").lower() or
                    query in n.get("end_marker", "").lower() or
                    query in n.get("snippet_preview", "").lower() or 
                    any(query in t.lower() for t in n.get("tags", []))):
                    print(f"  [{idx}] {n['title']} [{n.get('category', 'General')}] (Mốc: {n.get('start_marker','')[:25]}...)")
                    found = True
            if not found:
                print(f"  {YELLOW}Không tìm thấy ghi chú nào phù hợp.{RESET}")
            continue

        if raw_choice.isdigit():
            idx = int(raw_choice) - 1
            if 0 <= idx < len(meta_list):
                target_file = os.path.join(NOTES_DIR, meta_list[idx]["html_file"])
                open_in_browser(target_file)
                continue

        print(f"{YELLOW}Lựa chọn không hợp lệ!{RESET}")

def main():
    parser = argparse.ArgumentParser(description="AGY Note: AI Snippet Note Saver, Multi-Note HTML Viewer & Cloud Sync")
    parser.add_argument("--add", "-a", action="store_true", help="Thêm ghi chú mới")
    parser.add_argument("--title", "-t", type=str, help="Tiêu đề ghi chú")
    parser.add_argument("--category", "-c", type=str, default="General", help="Category phân loại ghi chú")
    parser.add_argument("--tags", type=str, default="", help="Tags cách nhau bởi dấu phẩy")
    parser.add_argument("--start-marker", "-sm", type=str, default="", help="Mốc điểm đầu của đoạn trích")
    parser.add_argument("--end-marker", "-em", type=str, default="", help="Mốc điểm cuối của đoạn trích")
    parser.add_argument("--content", type=str, help="Nội dung ghi chú dạng Markdown/Text")
    parser.add_argument("--conversation-id", type=str, default="", help="Mã phiên hội thoại AGY")
    parser.add_argument("--list", "-l", action="store_true", help="Xem danh sách ghi chú")
    parser.add_argument("--open", "-o", nargs="+", help="Mở 1 hoặc nhiều note cùng lúc theo STT/ID (VD: -o 1 2 3)")
    parser.add_argument("--compare", "--split", "-cmp", dest="compare", nargs="+", help="Xem cùng lúc 2-4 note ở chế độ Split Screen")
    parser.add_argument("--web", "-w", action="store_true", help="Mở trang Web Hub dashboard")
    parser.add_argument("--view", "-v", type=str, help="Xem nội dung note trên terminal")
    parser.add_argument("--search", "-s", type=str, help="Tìm kiếm ghi chú")
    parser.add_argument("--delete", "-d", type=str, help="Xóa ghi chú theo STT hoặc ID")
    parser.add_argument("--rebuild", action="store_true", help="Tạo lại toàn bộ HTML từ metadata và markdown files")
    parser.add_argument("--setup-cloud", action="store_true", help="Thiết lập kết nối Cloudflare / Vercel / GitHub Pages")
    parser.add_argument("--deploy", action="store_true", help="Kích hoạt đồng bộ Cloud ngay lập tức")

    args = parser.parse_args()

    if args.setup_cloud:
        interactive_setup_cloud()
        return

    if args.deploy:
        ok, msg = deploy_to_cloud(silent=False)
        if ok:
            print(f"{GREEN}✓ Đồng bộ thành công: {msg}{RESET}")
        else:
            print(f"{RED}Không thể đồng bộ: {msg}{RESET}")
        return

    if args.rebuild:
        meta_list = load_metadata()
        for item in meta_list:
            html_path = os.path.join(NOTES_DIR, item["html_file"])
            rendered = generate_single_note_html(item)
            with open(html_path, "w", encoding="utf-8") as f:
                f.write(rendered)
        generate_web_hub(meta_list)
        print(f"{GREEN}✓ Đã tạo lại toàn bộ {len(meta_list)} HTML Notes và Web Hub Dashboard thành công!{RESET}")
        return

    if args.add or args.title or args.content:
        content = args.content
        if not content:
            if not sys.stdin.isatty():
                content = sys.stdin.read().strip()
            else:
                print(f"{RED}Nội dung không được để trống!{RESET}")
                return

        title = args.title or "Untitled Snippet"
        note_data, path = add_note(
            title=title,
            content=content,
            category=args.category,
            tags=args.tags,
            start_marker=args.start_marker,
            end_marker=args.end_marker,
            conversation_id=args.conversation_id
        )
        print(f"{GREEN}✓ Đã lưu note: '{note_data['title']}' [{note_data['category']}]{RESET}")
        if note_data.get('start_marker'):
            print(f"{DIM}  🟢 Mốc đầu: \"{note_data['start_marker']}\"{RESET}")
        if note_data.get('end_marker'):
            print(f"{DIM}  🔴 Mốc cuối: \"{note_data['end_marker']}\"{RESET}")
        print(f"{CYAN}File: {path}{RESET}")
        return

    if args.web:
        open_in_browser(HUB_FILE)
        return

    if args.list:
        list_notes_terminal()
        return

    if args.compare:
        target_list = args.compare
        open_multiple_in_browser(target_list)
        return

    if args.open:
        if len(args.open) == 1 and "," in args.open[0]:
            target_list = [x.strip() for x in args.open[0].split(",") if x.strip()]
        else:
            target_list = args.open
        open_multiple_in_browser(target_list)
        return

    if args.view:
        view_note_terminal(args.view)
        return

    if args.search:
        meta_list = load_metadata()
        q = args.search.lower()
        print(f"\n{BOLD}Kết quả tìm kiếm cho: \"{q}\"{RESET}")
        for idx, n in enumerate(meta_list, 1):
            if (q in n["title"].lower() or 
                q in n.get("category", "").lower() or
                q in n.get("start_marker", "").lower() or
                q in n.get("end_marker", "").lower() or
                q in n.get("snippet_preview", "").lower() or 
                any(q in t.lower() for t in n.get("tags", []))):
                print(f"  [{idx}] {n['title']} [{n.get('category', 'General')}] -> {n['html_file']}")
        return

    if args.delete:
        meta_list = load_metadata()
        target_id = args.delete
        if args.delete.isdigit():
            idx = int(args.delete) - 1
            if 0 <= idx < len(meta_list):
                target_id = meta_list[idx]["id"]
        ok, title = delete_note_by_id(target_id)
        if ok:
            print(f"{GREEN}✓ Đã xóa ghi chú '{title}'!{RESET}")
        else:
            print(f"{RED}Không tìm thấy note để xóa: {args.delete}{RESET}")
        return

    interactive_menu()

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nĐã hủy.")
