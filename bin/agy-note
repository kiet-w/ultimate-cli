    <script>
        function initTheme() {{
            const saved = localStorage.getItem('agy_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', saved);
            updateThemeBtn(saved);
        }}

        function toggleTheme() {{
            const current = document.documentElement.getAttribute('data-theme') || 'dark';
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('agy_theme', next);
            updateThemeBtn(next);
        }}

        function updateThemeBtn(theme) {{
            const icon = document.getElementById('themeIcon');
            const label = document.getElementById('themeLabel');
            if (icon && label) {{
                if (theme === 'dark') {{
                    icon.innerText = '☀️';
                    label.innerText = 'Sáng';
                }} else {{
                    icon.innerText = '🌙';
                    label.innerText = 'Tối';
                }}
            }}
        }}

        function showToast(msg) {{
            const t = document.getElementById('toastMsg');
            t.innerText = msg;
            t.style.display = 'flex';
            setTimeout(() => {{
                t.style.display = 'none';
            }}, 2200);
        }}

        function copyCode(button) {{
            const container = button.closest('.code-container');
            const codeEl = container.querySelector('code');
            const text = codeEl.innerText;
            navigator.clipboard.writeText(text).then(() => {{
                const originalHtml = button.innerHTML;
                button.innerHTML = '✓ Copied';
                button.style.color = '#34d399';
                showToast('✓ Đã copy đoạn code!');
                setTimeout(() => {{
                    button.innerHTML = originalHtml;
                    button.style.color = '';
                }}, 2000);
            }});
        }}

        function copyEntireNote(button) {{
            const text = document.getElementById('noteContentArea').innerText;
            navigator.clipboard.writeText(text).then(() => {{
                const originalText = button.innerHTML;
                button.innerHTML = '✓ Đã Copy';
                button.style.color = '#34d399';
                showToast('✓ Đã copy toàn bộ nội dung!');
                setTimeout(() => {{
                    button.innerHTML = originalText;
                    button.style.color = '';
                }}, 2000);
            }});
        }}

        initTheme();
    </script>
</body>
</html>
"""

def generate_web_hub(meta_list):
    """
    Builds the central `index.html` Web Hub dashboard with Taste-Design architecture
    and 1-click Dark/Light mode toggle.
    """
    ensure_dirs()
    notes_json_str = json.dumps(meta_list, ensure_ascii=False)
    deploy_cfg = load_deploy_config()
    live_url = deploy_cfg.get("live_url", "")

    cloud_badge_html = ""
    if live_url:
        cloud_badge_html = f'''
        <a href="{live_url}" target="_blank" class="live-cloud-badge" title="Mở trang Cloud Public">
            <span class="live-dot"></span>
            <span>🌐 {html.escape(live_url.replace("https://", ""))}</span>
        </a>
        '''

    hub_html = f"""<!DOCTYPE html>
