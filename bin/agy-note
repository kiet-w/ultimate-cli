#!/usr/bin/env python3
"""
agy-note: Antigravity CLI Snippet Note Manager, Multi-Note HTML Viewer & Cloud Sync
Upgraded with Taste-Design Architecture:
- Dual-Theme System (Curated Charcoal Dark & Warm Zinc Light) with 1-click Toggle
- Plus Jakarta Sans + JetBrains Mono Typography Pairing (Anti-AI generic styling)
- Middle Gray Surface Balance & Tactile Subtle Contrast
- Mobile-First & Desktop Adaptive Responsive Architecture
- Touch-Friendly 44px Target Zones & Horizontal Scroll Chip Bars
- Interactive Expandable Accordions (<details>/<summary>) for deep-dive branches (Kiểu A)
- Structured Section Cards with Headers & Tags
- Key-Value Item Badges for lists (e.g. 1.1 Purpose: ...)
- Sticky Section Navigator (Table of Contents)
- Split View (2, 3, 4 notes simultaneously)
- Cloud Sync (Cloudflare Pages, Vercel, Surge, GitHub Pages)
- Permanent raw Markdown backup in notes/md/
"""

import os
import sys
import json
import glob
import re
import html
import shutil
import argparse
import subprocess
import threading
from datetime import datetime

NOTES_DIR = os.path.expanduser("~/.gemini/antigravity-cli/notes")
HTML_DIR = os.path.join(NOTES_DIR, "html")
MD_DIR = os.path.join(NOTES_DIR, "md")
META_FILE = os.path.join(NOTES_DIR, "notes_metadata.json")
HUB_FILE = os.path.join(NOTES_DIR, "index.html")
DEPLOY_CONFIG_FILE = os.path.join(NOTES_DIR, "deploy_config.json")

# ANSI Color codes for Terminal TUI
BOLD = "\033[1m"
DIM = "\033[2m"
CYAN = "\033[36m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
BLUE = "\033[34m"
MAGENTA = "\033[35m"
RED = "\033[31m"
RESET = "\033[0m"

CATEGORY_COLORS = {
    "work": BLUE,
    "study": GREEN,
    "debug": RED,
    "linux": YELLOW,
    "backend": CYAN,
    "frontend": MAGENTA,
    "docker": BLUE,
    "ai": MAGENTA,
    "agy": CYAN,
    "tip": GREEN,
    "tender1-2": YELLOW,
    "general": DIM,
}

def ensure_dirs():
    os.makedirs(NOTES_DIR, exist_ok=True)
    os.makedirs(HTML_DIR, exist_ok=True)
    os.makedirs(MD_DIR, exist_ok=True)

def load_metadata():
    ensure_dirs()
    if os.path.exists(META_FILE):
        try:
            with open(META_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return []
    return []

def save_metadata(meta_list):
    ensure_dirs()
    try:
        with open(META_FILE, "w", encoding="utf-8") as f:
            json.dump(meta_list, f, indent=2, ensure_ascii=False)
    except Exception as e:
        print(f"{RED}Lỗi khi lưu metadata: {e}{RESET}", file=sys.stderr)

def load_deploy_config():
    ensure_dirs()
    if os.path.exists(DEPLOY_CONFIG_FILE):
        try:
            with open(DEPLOY_CONFIG_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}
    return {}

def save_deploy_config(cfg):
    ensure_dirs()
    try:
        with open(DEPLOY_CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2, ensure_ascii=False)
    except Exception as e:
        print(f"{RED}Lỗi khi lưu deploy config: {e}{RESET}", file=sys.stderr)

def format_category_terminal(cat):
    if not cat:
        return f"{DIM}[note]{RESET}"
    color = CATEGORY_COLORS.get(cat.lower(), MAGENTA)
    return f"{color}[{cat}]{RESET}"

def format_inline_markdown(text):
    if text.startswith("<details") or text.startswith("</details>") or text.startswith("<summary") or text.startswith("</summary>"):
        return text
    text = html.escape(text)
    text = re.sub(r'`([^`]+)`', r'<code class="inline-code">\1</code>', text)
    text = re.sub(r'\*\*([^*]+)\*\*', r'<strong>\1</strong>', text)
    text = re.sub(r'\*([^*]+)\*', r'<em>\1</em>', text)
    return text

def parse_rich_markdown(md_text):
    """
    Transforms raw markdown into a visually rich, card-based editorial layout.
    Supports Kiểu A: Expandable Accordion Deep-Dive Branches (<details><summary>...</summary>...</details>).
    """
    if not md_text:
        return [], {"section_count": 0, "item_count": 0}, "<p class='note-pro-p'>Chưa có nội dung ghi chú.</p>"

    lines = md_text.split("\n")
    html_parts = []
    toc = []
    
    in_code = False
    code_lang = ""
    code_buffer = []
    
    in_section = False
    in_table = False
    table_headers = []
    table_rows = []

    in_details = False

    section_count = 0
    item_count = 0

    for line in lines:
        stripped = line.strip()

        # Handle Code blocks
        if stripped.startswith("```"):
            if in_code:
                raw_code = "\n".join(code_buffer)
                escaped_code = html.escape(raw_code)
                badge = f'<span class="code-lang-badge">{html.escape(code_lang or "code")}</span>'
                block = f'''
                <div class="code-container">
                    <div class="code-header">
                        <div class="code-dots">
                            <span class="dot dot-red"></span>
                            <span class="dot dot-yellow"></span>
                            <span class="dot dot-green"></span>
                        </div>
                        {badge}
                        <button class="copy-btn" onclick="copyCode(this)">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                            Copy
                        </button>
                    </div>
                    <pre><code class="language-{html.escape(code_lang)}">{escaped_code}</code></pre>
                </div>
                '''
                html_parts.append(block)
                in_code = False
                code_buffer = []
                code_lang = ""
            else:
                in_code = True
                code_lang = stripped[3:].strip()
                code_buffer = []
            continue

        if in_code:
            code_buffer.append(line)
            continue

        # Handle <details> / <summary> Kiểu A expandable branches
        if "<details" in stripped:
            in_details = True
            html_parts.append('<details class="pro-branch">')
            continue
        if "</details>" in stripped:
            in_details = False
            html_parts.append('</div></details>')
            continue
        if in_details and "<summary>" in stripped and "</summary>" in stripped:
            m = re.search(r'<summary>(.*?)</summary>', stripped)
            summary_txt = m.group(1) if m else "🔍 Xem giải thích chi tiết"
            html_parts.append(f'''
            <summary class="branch-toggle">
                <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                <span class="summary-label">{format_inline_markdown(summary_txt)}</span>
            </summary>
            <div class="branch-content">
            ''')
            continue

        # Handle Table parsing
        if stripped.startswith("|") and stripped.endswith("|"):
            cells = [c.strip() for c in stripped.strip("|").split("|")]
            if all(set(c).issubset(set("-: ")) for c in cells):
                continue
            if not in_table:
                in_table = True
                table_headers = cells
                table_rows = []
            else:
                table_rows.append(cells)
            continue
        else:
            if in_table:
                thead_html = "".join([f"<th>{format_inline_markdown(h)}</th>" for h in table_headers])
                tbody_html = ""
                for row in table_rows:
                    row_cells = "".join([f"<td>{format_inline_markdown(c)}</td>" for c in row])
                    tbody_html += f"<tr>{row_cells}</tr>"
                tbl_block = f'''
                <div class="table-container">
                    <table class="pro-table">
                        <thead><tr>{thead_html}</tr></thead>
                        <tbody>{tbody_html}</tbody>
                    </table>
                </div>
                '''
                html_parts.append(tbl_block)
                in_table = False
                table_headers = []
                table_rows = []

        if stripped in ["---", "===", "──────", "------"]:
            continue

        # Section Headings (H2, H3, H4)
        if stripped.startswith("#### ") or stripped.startswith("### ") or stripped.startswith("## "):
            if in_section:
                html_parts.append("</div></section>")
                in_section = False

            level = 4 if stripped.startswith("#### ") else (3 if stripped.startswith("### ") else 2)
            title_raw = stripped[level+1:].strip()
            
            sec_id = re.sub(r'[^a-zA-Z0-9_-]', '', title_raw.lower().replace(' ', '-'))[:35]
            if not sec_id:
                sec_id = f"sec-{section_count + 1}"

            section_count += 1
            toc.append((title_raw, sec_id))

            html_parts.append(f'''
            <section class="pro-section-card" id="{sec_id}">
                <div class="section-card-header">
                    <div class="sec-title-group">
                        <span class="sec-num-badge">§ {section_count}</span>
                        <h3 class="sec-heading">{format_inline_markdown(title_raw)}</h3>
                    </div>
                    <a href="#{sec_id}" class="sec-anchor-link" title="Liên kết đến mục này">#</a>
                </div>
                <div class="section-card-body">
            ''')
            in_section = True
            continue

        # Top H1 Title
        if stripped.startswith("# "):
            html_parts.append(f'<h1 class="main-note-heading">{format_inline_markdown(stripped[2:])}</h1>')
            continue

        # Bullet List Items with Key-Value Recognition
        if stripped.startswith("- ") or stripped.startswith("• ") or stripped.startswith("* "):
            item_content = stripped[2:].strip()
            item_count += 1

            kv_match = re.match(r'^\*\*([^*]+)\*\*:\s*(.*)$', item_content)
            if not kv_match:
                kv_match = re.match(r'^([0-9]+\.[0-9]+(?:\.[0-9]+)?\s+[^:]+):\s*(.*)$', item_content)
            if not kv_match:
                kv_match = re.match(r'^([A-Z0-9\.\-_]{2,20}):\s*(.*)$', item_content)

            is_subitem = (line.startswith("    ") or line.startswith("\t") or line.startswith("  ") or 
                          re.match(r'^[•\-\*]\s+[0-9]+\.[0-9]+\.[0-9]+', stripped))

            if kv_match:
                key, val = kv_match.group(1), kv_match.group(2)
                sub_cls = "sub-item" if is_subitem else ""
                html_parts.append(f'''
                <div class="kv-item-card {sub_cls}">
                    <div class="kv-header">
                        <span class="kv-badge">{format_inline_markdown(key)}</span>
                    </div>
                    <div class="kv-body">{format_inline_markdown(val)}</div>
                </div>
                ''')
            else:
                sub_cls = "sub-item" if is_subitem else ""
                html_parts.append(f'''
                <div class="plain-bullet-item {sub_cls}">
                    <span class="bullet-dot"></span>
                    <span class="bullet-text">{format_inline_markdown(item_content)}</span>
                </div>
                ''')
            continue

        # Blockquote / Callout
        if stripped.startswith("> "):
            quote_text = stripped[2:].strip()
            callout_type = "info"
            if "[!WARNING]" in quote_text or "Lưu ý:" in quote_text or "Cảnh báo:" in quote_text:
                callout_type = "warning"
            elif "[!TIP]" in quote_text or "Mẹo:" in quote_text or "Gợi ý:" in quote_text:
                callout_type = "tip"
            elif "[!SUCCESS]" in quote_text or "Thành công:" in quote_text:
                callout_type = "success"

            clean_quote = re.sub(r'\[!(NOTE|TIP|WARNING|IMPORTANT|SUCCESS)\]', '', quote_text).strip()
            html_parts.append(f'''
            <div class="pro-callout callout-{callout_type}">
                <div class="callout-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                </div>
                <div class="callout-text">{format_inline_markdown(clean_quote)}</div>
            </div>
            ''')
            continue

        if not stripped:
            continue

        html_parts.append(f'<p class="note-pro-p">{format_inline_markdown(stripped)}</p>')

    if in_section:
        html_parts.append("</div></section>")

    if in_table:
        thead_html = "".join([f"<th>{format_inline_markdown(h)}</th>" for h in table_headers])
        tbody_html = ""
        for row in table_rows:
            row_cells = "".join([f"<td>{format_inline_markdown(c)}</td>" for c in row])
            tbody_html += f"<tr>{row_cells}</tr>"
        tbl_block = f'''
        <div class="table-container">
            <table class="pro-table">
                <thead><tr>{thead_html}</tr></thead>
                <tbody>{tbody_html}</tbody>
            </table>
        </div>
        '''
        html_parts.append(tbl_block)

    stats = {
        "section_count": section_count,
        "item_count": item_count
    }

    return toc, stats, "\n".join(html_parts)

def generate_single_note_html(note_data):
    """
    Renders standalone HTML with curated Charcoal Dark and Warm Zinc Light themes.
    """
    raw_content = note_data.get("content", "")
    
    if not raw_content and note_data.get("id"):
        md_file = os.path.join(MD_DIR, f"{note_data['id']}.md")
        if os.path.exists(md_file):
            try:
                with open(md_file, "r", encoding="utf-8") as f:
                    raw_content = f.read()
            except Exception:
                pass

    toc, stats, body_html = parse_rich_markdown(raw_content)
    
    tags_html = "".join([f'<span class="tag-badge">#{html.escape(t)}</span>' for t in note_data.get("tags", [])])
    cat = html.escape(note_data.get("category", "General"))
    title = html.escape(note_data.get("title", "Untitled Note"))
    created_at = note_data.get("created_at", "")
    start_marker = html.escape(note_data.get("start_marker", "") or "")
    end_marker = html.escape(note_data.get("end_marker", "") or "")

    try:
        dt_obj = datetime.fromisoformat(created_at)
        formatted_date = dt_obj.strftime("%H:%M • %d/%m/%Y")
    except Exception:
        formatted_date = created_at

    toc_html = ""
    if len(toc) >= 2:
        toc_items = "".join([f'<a href="#{sec_id}" class="toc-chip"><span class="toc-num">{idx+1}</span><span>{html.escape(stitle[:28])}</span></a>' for idx, (stitle, sec_id) in enumerate(toc)])
        toc_html = f'''
        <div class="toc-nav-bar">
            <div class="toc-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                Mục Lục ({len(toc)})
            </div>
            <div class="toc-chips-scroll">
                {toc_items}
            </div>
        </div>
        '''

    landmarks_html = f"""
    <div class="landmark-box">
        <div class="landmark-title">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            Mốc Trích Xuất
        </div>
        <div class="landmark-grid">
            <div class="landmark-item">
                <span class="landmark-label">Category:</span>
                <span class="cat-badge">{cat}</span>
            </div>
            <div class="landmark-item">
                <span class="landmark-label">Thời gian:</span>
                <span class="landmark-val">{formatted_date}</span>
            </div>
            {"<div class='landmark-item full-row'><span class='landmark-label'>Mốc đầu:</span><span class='landmark-marker start'>&ldquo;" + start_marker + "&rdquo;</span></div>" if start_marker else ""}
            {"<div class='landmark-item full-row'><span class='landmark-label'>Mốc cuối:</span><span class='landmark-marker end'>&ldquo;" + end_marker + "&rdquo;</span></div>" if end_marker else ""}
        </div>
    </div>
    """

    return f"""<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <title>{title} | AGY Note</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {{
            /* Dark Theme: Balanced Charcoal with Mid-Gray surfaces (Not pure black) */
            --bg-color: #0f1117;
            --surface-bg: #181c26;
            --card-bg: #1e2330;
            --card-inner: #262c3c;
            --card-hover: #232938;
            --code-bg: #0c0e14;
            --text-primary: #f1f5f9;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --accent-color: #38bdf8;
            --accent-subtle: rgba(56, 189, 248, 0.12);
            --tag-color: #c084fc;
            --tag-subtle: rgba(192, 132, 252, 0.12);
            --border-color: rgba(255, 255, 255, 0.08);
            --border-focus: rgba(56, 189, 248, 0.35);
            --shadow-subtle: 0 4px 20px rgba(0, 0, 0, 0.4);
            --kv-border: rgba(255, 255, 255, 0.06);
        }}

        [data-theme="light"] {{
            /* Light Theme: Balanced Warm Zinc / Crisp Slate (Not blinding pure white) */
            --bg-color: #f4f4f6;
            --surface-bg: #ffffff;
            --card-bg: #ffffff;
            --card-inner: #f1f2f5;
            --card-hover: #eaebee;
            --code-bg: #181c24;
            --text-primary: #18181b;
            --text-secondary: #52525b;
            --text-muted: #71717a;
            --accent-color: #0284c7;
            --accent-subtle: rgba(2, 132, 199, 0.1);
            --tag-color: #7c3aed;
            --tag-subtle: rgba(124, 58, 237, 0.09);
