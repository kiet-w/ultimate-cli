#!/usr/bin/env bash
# Antigravity CLI Wrapper: maps --yolo to --dangerously-skip-permissions and prompts on exit

exit_hook_executed=0

cleanup_and_prompt() {
    if [ "$exit_hook_executed" -eq 1 ]; then
        return
    fi
    exit_hook_executed=1
    # Reset traps to avoid loops
    trap - EXIT INT TERM HUP
    
    # Run agy-history --on-exit
    if [ -x "$HOME/.local/bin/agy-history" ]; then
        python3 "$HOME/.local/bin/agy-history" --on-exit
    fi
}

trap cleanup_and_prompt EXIT INT TERM HUP

new_args=()
for arg in "$@"; do
    if [ "$arg" = "--yolo" ]; then
        new_args+=("--dangerously-skip-permissions")
    else
        new_args+=("$arg")
    fi
done

if [ -x "$HOME/.local/bin/agy-real" ]; then
    "$HOME/.local/bin/agy-real" "${new_args[@]}"
elif command -v agy-real >/dev/null 2>&1; then
    agy-real "${new_args[@]}"
else
    echo "Lỗi: Không tìm thấy binary agy-real!" >&2
    exit 1
fi

status=$?
cleanup_and_prompt
exit $status
